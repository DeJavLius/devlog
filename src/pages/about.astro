---
import AuthorCard from '@/components/AuthorCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllAuthors } from '@/lib/data-utils'

const authors = await getAllAuthors()
---

<Layout>
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="text-muted-foreground mb-2 text-sm">
          백엔드 개발자로 일하고 있으며 풀스택 개발자로 진화하고자 React, Astro,
          Typescript를 활용해 현재 블로그를 개발하는 중입니다. 주 목적이
          프론트엔드 개발에 익숙해지는 것이어서 Netlify로 배포해 서버 동작을
          최소화하려고 합니다.
        </p>
        <p class="text-muted-foreground mb-2 text-sm">
          🏗️ astro-erudite 테마 활용 스택: <Link
            href="https://astro.build"
            class="text-foreground"
            external
            underline
          >
            <img
              src="/static/astro-icon-light-gradient.svg"
              class="m-auto inline size-6"
            />Astro
          </Link>,
          <Link
            href="https://tailwindcss.com"
            class="text-foreground"
            external
            underline
          >
            <img
              src="/static/tailwindcss-mark.svg"
              class="m-auto inline size-6"
            />tailwind
          </Link>,
          <Link
            href="https://ui.shadcn.com"
            class="text-foreground"
            external
            underline
          >
            <img
              src="/static/shadcn-ui-seeklogo.svg"
              class="m-auto inline size-6"
            />shadcn/ui
          </Link>,
          <Link
            href="https://react.dev/"
            class="text-foreground"
            external
            underline
          >
            <img
              src="/static/React-icon.svg"
              class="m-auto inline size-6"
            />React
          </Link>
        </p>
        <p class="text-muted-foreground mb-2 text-sm">
          <Link
            href="https://obsidian.md/"
            class="text-foreground"
            external
            underline
          >
            <img
              src="/static/obsidian-icon.ico"
              class="m-auto inline size-6"
            />Obsidian
          </Link>로 포스트 로컬 수정
        </p>
      </div>

      <h2 class="mb-4 text-2xl font-medium">개발자</h2>
      <div class="flex flex-col gap-4">
        {authors.map((authors) => <AuthorCard author={authors} />)}
      </div>
    </div>
  </section>
</Layout>
