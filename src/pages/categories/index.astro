---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { getSortedCategories } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const sortedTags = await getSortedCategories()
---

<Layout>
  <PageHead slot="head" title="Categories" />
  <Breadcrumbs items={[{ label: 'Categories', icon: 'lucide:list-tree' }]} />

  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap gap-2">
      {
        sortedTags.map(({ category, count }) => (
          <Link
            href={`/categories/${category}`}
            class={badgeVariants({ variant: 'secondary' })}
          >
            <Icon name="lucide:sticky-note" class="size-3" />
            {category}
            <span class="text-muted-foreground ml-1.5">({count})</span>
          </Link>
        ))
      }
    </div>
  </div>
</Layout>
