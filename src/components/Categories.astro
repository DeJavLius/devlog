---
import Link from '@/components/Link.astro'
import { badgeVariants } from '@/components/ui/badge'
import { getSortedCategoriesByCount } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const sortedCategories = await getSortedCategoriesByCount()

console.log(typeof sortedCategories)
console.log(sortedCategories)
---

<div class="flex flex-col gap-4">
  <div class="flex flex-wrap gap-2">
    {
      sortedCategories.map(({ category, count }) => (
        <Link
          href={`/categories/${category}`}
          class={badgeVariants({ variant: 'secondary' })}
        >
          <Icon name="lucide:book" class="size-3" />
          {category}
          <span class="text-muted-foreground ml-1.5">({count})</span>
        </Link>
      ))
    }
  </div>
</div>
