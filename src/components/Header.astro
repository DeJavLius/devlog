---
import Link from '@/components/Link.astro'
// import ThemeToggle from '@/components/ThemeToggle.astro'
import MobileMenu from '@/components/ui/mobile-menu'
import ThemeMenu from '@/components/ui/theme-menu'
import { NAV_LINKS, SITE } from '@/consts'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'
import ThemeToggle from './ThemeToggle.astro'
---

<header
  class="bg-background/50 sticky top-0 z-10 backdrop-blur-md"
  transition:persist
>
  <div
    class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 p-4"
  >
    <Link href="/" class="flex shrink-0 items-center gap-2 text-xl font-medium">
      <Image src={logo} alt="Logo" class="size-8" />
      {SITE.title}
    </Link>
    <div class="flex items-center gap-2 md:gap-4">
      <nav class="hidden items-center gap-4 text-sm sm:gap-6 md:flex">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground/80 capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <MobileMenu client:load transition:persist />
      <!-- <ThemeToggle transition:persist /> -->
      <ThemeMenu client:load transition:persist />
    </div>
  </div>
</header>

<script is:inline data-astro-rerun>
  const THEME_COLORS = [
    'light',
    'dark',
    'cream',
    'royalBlue',
    'pistachio',
    'pastelGray',
  ]

  const theme = (() => {
    const localStorageTheme = localStorage?.getItem('theme') ?? ''
    const themeColors = THEME_COLORS.map((v) => {
      return v.label
    })

    if (themeColors.includes(localStorageTheme)) {
      return localStorageTheme
    }

    let color = 'light'

    for (let c in themeColors) {
      if (window.matchMedia(`(prefers-color-scheme: ${c})`).matches) {
        color = c
        break
      }
    }

    return color
  })()

  window.localStorage.setItem('theme', theme)
</script>
